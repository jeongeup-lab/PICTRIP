{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pictrip-img-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-16",
  "routes": [{ "pattern": "img.pictrip.org", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
