# Public runtime config (Expo inlines EXPO_PUBLIC_* at build time).
# Must include the /v1 base path — the client sends bare paths and a base without
# /v1 makes every request 404 (see env.ts fallback).
EXPO_PUBLIC_API_BASE=https://api.pictrip.org/v1

# OAuth client IDs / keys — fill from provider consoles (see spec §11).
# Leave blank in dev; the matching social button shows an inline error if used.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_KAKAO_REST_KEY=

# Kakao Maps JavaScript app key (KakaoWebMap WebView). Blank → map renders a
# blank placeholder; list/permission/picker still work. See spec §9.
EXPO_PUBLIC_KAKAO_JS_KEY=
